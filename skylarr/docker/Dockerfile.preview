# Dockerfile for Skylarr Preview Containers
FROM php:8.2-fpm-alpine

# Install system dependencies
RUN apk add --no-cache \
    nginx \
    curl \
    git \
    unzip \
    nodejs \
    npm \
    bash \
    supervisor \
    && rm -rf /var/cache/apk/*

# Install Bun
RUN curl -fsSL https://bun.sh/install | bash
ENV PATH="/root/.bun/bin:$PATH"

# Install PHP extensions
RUN docker-php-ext-install pdo pdo_mysql

# Install Composer
COPY --from=composer:latest /usr/bin/composer /usr/bin/composer

# Set working directory
WORKDIR /var/www/html

# Copy base Laravel application structure
COPY ./preview-base/ /var/www/html/

# Create a temporary composer.json without problematic scripts for Docker build
RUN cp composer.json composer.json.backup && \
    sed -i '/"post-autoload-dump"/,/],/d' composer.json

# Install PHP dependencies (--no-dev will skip Pail since it's in require-dev)
RUN composer install --no-dev --optimize-autoloader --no-interaction --ignore-platform-reqs

# Restore original composer.json
RUN mv composer.json.backup composer.json

# Clear all Laravel caches to remove any dev service provider references
# This is critical to prevent PailServiceProvider errors
RUN rm -rf bootstrap/cache/*.php 2>/dev/null || true && \
    rm -rf storage/framework/cache/* 2>/dev/null || true && \
    php artisan config:clear 2>/dev/null || true && \
    php artisan cache:clear 2>/dev/null || true && \
    php artisan route:clear 2>/dev/null || true && \
    php artisan view:clear 2>/dev/null || true && \
    composer dump-autoload --no-dev --optimize --classmap-authoritative 2>/dev/null || true

# Install dependencies and build assets with Bun
RUN bun install && bun run build

# Create necessary directories
RUN mkdir -p /var/www/html/app/Livewire/Generated \
    && mkdir -p /var/www/html/storage/logs \
    && mkdir -p /var/www/html/storage/framework/cache \
    && mkdir -p /var/www/html/storage/framework/sessions \
    && mkdir -p /var/www/html/storage/framework/views \
    && mkdir -p /var/www/html/bootstrap/cache \
    && mkdir -p /var/log/supervisor

# Set permissions
RUN chown -R www-data:www-data /var/www/html \
    && chmod -R 755 /var/www/html/storage \
    && chmod -R 755 /var/www/html/bootstrap/cache

# Copy nginx configuration
COPY ./docker/nginx.conf /etc/nginx/nginx.conf

# Copy supervisor configuration
COPY ./docker/supervisord.conf /etc/supervisor/conf.d/supervisord.conf

# Copy startup script
COPY ./docker/start.sh /start.sh
RUN chmod +x /start.sh

# Expose port 80
EXPOSE 80

# Health check
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:80/health || exit 1

# Start services
CMD ["/start.sh"]
