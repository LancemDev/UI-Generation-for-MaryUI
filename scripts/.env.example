# Skylarr AI service settings. Copy to .env and fill in a key.
AI_PROVIDER=openai

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1
# Optional cheaper model for repairs and changes scoped to a selection.
OPENAI_FAST_MODEL=

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_FAST_MODEL=

AI_MAX_OUTPUT_TOKENS=16000

# Shared secret with the Laravel app (AI_SERVICE_TOKEN in skylarr/.env).
AI_SERVICE_TOKEN=
